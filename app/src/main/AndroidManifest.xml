<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to enumerate every installed app (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Island's public "freeze/unfreeze" API is a normal dangerous permission,
         requested at runtime the same way as e.g. CAMERA. -->
    <uses-permission android:name="com.oasisfeng.island.permission.FREEZE_PACKAGE" />
    <uses-permission android:name="com.oasisfeng.island.permission.LAUNCH_PACKAGE" />

    <!-- Only used as a fallback signal; harmless to declare even if Shizuku
         itself doesn't require a manifest permission for its own API. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <!-- Let us detect + talk to Shizuku and Island even on Android 11+ -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.oasisfeng.island" />
        <package android:name="com.oasisfeng.island.fdroid" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".Link2SDApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_sd_card"
        android:roundIcon="@drawable/ic_sd_card"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/menu_settings" />

        <activity
            android:name=".ui.StorageInfoActivity"
            android:exported="false"
            android:label="@string/menu_storage_info" />

        <activity
            android:name=".lock.LockActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".lock.LockSetupActivity"
            android:exported="false"
            android:label="قفل التطبيق" />

        <!-- Required so "Share app" (ctx_share_apk) can hand the APK file to
             other apps without exposing a file:// Uri (Android 7+ StrictMode). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- rikka.shizuku:shizuku-provider merges its own <provider> entry
             automatically from its AAR manifest — nothing to add here. -->

    </application>

</manifest>
