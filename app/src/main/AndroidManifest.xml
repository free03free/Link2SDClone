<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="com.oasisfeng.island.permission.FREEZE_PACKAGE" />
    <uses-permission android:name="com.oasisfeng.island.permission.LAUNCH_PACKAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.oasisfeng.island" />
        <package android:name="com.oasisfeng.island.fdroid" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".Link2SDApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_freelinksd"
        android:roundIcon="@drawable/ic_freelinksd"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/menu_settings" />

        <activity
            android:name=".ui.StorageInfoActivity"
            android:exported="false"
            android:label="@string/menu_storage_info" />

                <activity
            android:name=".ui.CacheExcludeActivity"
            android:exported="false"
            android:label="@string/pref_exclusion_list_title" />

                <activity
            android:name=".groups.GroupsActivity"
            android:exported="false"
            android:label="@string/groups_title" />

        <activity
            android:name=".groups.GroupAppsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppDetailsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".lock.LockActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".lock.LockSetupActivity"
            android:exported="false"
            android:label="قفل التطبيق" />

        <receiver
            android:name=".receiver.PackageInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Required so "Share app" (ctx_share_apk) can hand the APK file to
             other apps without exposing a file:// Uri (Android 7+ StrictMode). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name="com.example.link2sdclone.ui.RootToolsActivity"
            android:exported="false" />
    <receiver
            android:name="com.example.link2sdclone.util.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
