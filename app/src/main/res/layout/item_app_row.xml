<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_android_default"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/row_select_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            android:contentDescription="@null" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_name_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="SlimSocial" />

        <TextView
            android:id="@+id/row_path"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_path_text"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="middle"
            tools:text="/data/app/com.slimsocial.nativeapp-DomDaATk2278AdKcz2Jx5w==/base.apk" />

        <TextView
            android:id="@+id/row_sizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/app_size_text"
            android:textSize="12sp"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            tools:text="apk:689KB Dex:41KB Lib:0.00B البيانات:0.00B الإجمالي:730KB المخبئ:0.00B" />

    </LinearLayout>

    <ImageView
        android:id="@+id/row_favorite"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_star_outline"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/row_sd_indicator"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_sd_card"
        android:visibility="gone"
        android:contentDescription="@null" />

</LinearLayout>
