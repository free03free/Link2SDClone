<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_selection"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/colorPrimary"
    android:visibility="gone"
    app:navigationIcon="@drawable/ic_back">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/toolbar_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/icon_select_all"
            style="?attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_select_all"
            app:tint="@color/toolbar_icon"
            android:contentDescription="@string/nav_all_apps" />

        <ImageButton
            android:id="@+id/icon_select_none"
            style="?attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_select_none"
            app:tint="@color/toolbar_icon"
            android:contentDescription="@string/nav_all_apps" />

        <ImageButton
            android:id="@+id/icon_selection_overflow"
            style="?attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/toolbar_icon"
            android:contentDescription="@string/menu_settings" />

    </LinearLayout>
</androidx.appcompat.widget.Toolbar>
