<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/text_storage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_name_text"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="ذاكرة الهاتف" />

    <TextView
        android:id="@+id/text_storage_path"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_path_text"
        android:textSize="13sp"
        tools:text="/data" />

    <ProgressBar
        android:id="@+id/bar_storage"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:progressTint="@color/storage_bar_used"
        android:progressBackgroundTint="@color/storage_bar_free" />

    <TextView
        android:id="@+id/text_storage_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textColor="@color/app_path_text"
        android:textSize="13sp"
        tools:text="الإجمالي: 56,46 غ.ب المستعمل: 15,42 غ.ب المتاح: 41,04 غ.ب (72% المتاح)" />

</LinearLayout>
