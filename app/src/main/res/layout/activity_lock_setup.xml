<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_lock_setup"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:title="قفل التطبيق"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_enable_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تفعيل قفل التطبيق" />

            <LinearLayout
                android:id="@+id/group_lock_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/radio_lock_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radio_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="رمز رقمي (PIN)"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/radio_pattern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="نمط" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_set_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="تعيين / تغيير الرمز" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="السماح بفتح القفل ببصمة الإصبع" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_code_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:gravity="center">

                <TextView
                    android:id="@+id/text_code_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/text_code_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:layout_marginTop="8dp"
                    android:visibility="invisible" />

                <EditText
                    android:id="@+id/edit_pin_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:inputType="numberPassword"
                    android:gravity="center"
                    android:hint="••••"
                    android:maxLength="8"
                    android:textSize="24sp" />

                <com.example.link2sdclone.lock.PatternLockView
                    android:id="@+id/pattern_view_setup"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_code_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="متابعة" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
